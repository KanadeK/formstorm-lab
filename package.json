{
  "name": "formstorm-lab",
  "version": "0.1.0",
  "description": "Generate reproducible form boundary, internationalization, accessibility, and validation tests from schemas.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "formstorm": "dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist/node",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsup",
    "build:web": "vite build",
    "capture:screenshot": "node scripts/capture_screenshot.mjs",
    "dev:web": "vite",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "demo": "node scripts/demo.mjs",
    "package": "node scripts/package_release.mjs",
    "release-check": "node scripts/release_check.mjs",
    "scan:secrets": "node scripts/scan_secrets.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:core": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build:node",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@faker-js/faker": "10.6.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.13.0",
    "commander": "15.0.0",
    "playwright": "1.62.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/adm-zip": "0.5.8",
    "@types/node": "22.15.29",
    "@vitest/coverage-v8": "4.1.10",
    "adm-zip": "0.6.0",
    "eslint": "10.8.0",
    "globals": "16.2.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.1"
    }
  }
}
