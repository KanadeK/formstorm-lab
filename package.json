{
  "name": "formstorm-lab",
  "version": "0.1.0",
  "description": "Generate reproducible form boundary, internationalization, accessibility, and validation tests from schemas.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "formstorm": "dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist/node",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "4.12.1",
    "@faker-js/faker": "9.6.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "axe-core": "4.12.1",
    "commander": "14.0.2",
    "playwright": "1.61.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@types/adm-zip": "0.5.8",
    "@types/node": "22.15.29",
    "@vitest/coverage-v8": "4.1.10",
    "adm-zip": "0.6.0",
    "eslint": "9.39.5",
    "globals": "16.2.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tsup": "8.3.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
