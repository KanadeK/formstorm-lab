{
  "name": "formstorm-lab",
  "version": "0.1.0",
  "description": "Generate reproducible form boundary, internationalization, accessibility, and validation tests from schemas.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "formstorm": "dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist/node",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsup",
    "build:web": "vite build",
    "capture:screenshot": "node scripts/capture_screenshot.mjs",
    "dev:web": "vite",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "demo": "node scripts/demo.mjs",
    "package": "node scripts/package_release.mjs",
    "release-check": "node scripts/release_check.mjs",
    "scan:secrets": "node scripts/scan_secrets.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:core": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build:node",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "4.12.1",
    "@faker-js/faker": "9.6.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.12.1",
    "commander": "14.0.2",
    "playwright": "1.61.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/adm-zip": "0.5.8",
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "adm-zip": "0.6.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.7",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.1"
    }
  }
}
